{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packetpulse.dev/schemas/packet-journey.schema.json",
  "title": "PacketJourney",
  "description": "One measured path of a flow/packet group from a source host to a destination, enriched with geolocation, infrastructure (fiber/subsea/cellular/IXP) and compliance evaluation. Emitted by the enrichment service; streamed to the globe as JourneyUpdate events.",
  "type": "object",
  "required": ["journey_id", "schema_version", "created_at", "probe", "source", "destination", "hops", "segments", "summary"],
  "properties": {
    "journey_id": {"type": "string", "format": "uuid"},
    "schema_version": {"const": "1.0.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "probe": {"$ref": "#/$defs/Probe"},
    "flow": {"$ref": "#/$defs/Flow"},
    "source": {"$ref": "#/$defs/Endpoint"},
    "destination": {"$ref": "#/$defs/Endpoint"},
    "hops": {"type": "array", "items": {"$ref": "#/$defs/Hop"}},
    "segments": {"type": "array", "items": {"$ref": "#/$defs/Segment"}},
    "compliance": {"$ref": "#/$defs/ComplianceEvaluation"},
    "summary": {"$ref": "#/$defs/Summary"},
    "dataset_versions": {
      "type": "object",
      "description": "Which snapshot of each reference DB produced this enrichment (for audit reproducibility).",
      "additionalProperties": {"type": "string"}
    }
  },
  "$defs": {
    "GeoPoint": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180},
        "accuracy_km": {"type": "number", "minimum": 0},
        "city": {"type": "string"},
        "country_iso2": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "subdivision": {"type": "string"}
      }
    },
    "Evidence": {
      "type": "object",
      "description": "One signal that contributed to a geolocation or infrastructure inference.",
      "required": ["source", "confidence"],
      "properties": {
        "source": {"enum": ["hoiho_rdns", "ripe_ipmap", "peeringdb_ixpfx", "peeringdb_fac", "maxmind_city", "maxmind_isp", "ipinfo", "dbip", "iptoasn", "rir_delegation", "cloud_ranges", "telegeography", "opencellid", "device_telephony", "rtt_constraint", "operator_override"]},
        "value": {},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "dataset_version": {"type": "string"}
      }
    },
    "Probe": {
      "type": "object",
      "required": ["probe_id", "method"],
      "properties": {
        "probe_id": {"type": "string"},
        "agent_version": {"type": "string"},
        "method": {"enum": ["paris-traceroute-udp", "paris-traceroute-icmp", "tcp-syn-traceroute", "mtr", "scamper", "ripe-atlas"]},
        "ip_version": {"enum": [4, 6]},
        "packets_per_hop": {"type": "integer", "minimum": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"}
      }
    },
    "Flow": {
      "type": "object",
      "description": "Optional link to the captured application flow that triggered this trace (from pcap/eBPF capture).",
      "properties": {
        "five_tuple": {
          "type": "object",
          "properties": {
            "src_ip": {"type": "string"}, "dst_ip": {"type": "string"},
            "src_port": {"type": "integer"}, "dst_port": {"type": "integer"},
            "protocol": {"enum": ["tcp", "udp", "icmp", "quic"]}
          }
        },
        "sni": {"type": "string"},
        "app_label": {"type": "string"},
        "bytes": {"type": "integer"},
        "packets": {"type": "integer"},
        "data_classification": {
          "enum": ["public", "internal", "confidential", "personal_data", "special_category", "payment", "health", "government", "important_data_cn"],
          "description": "Set by the Business Mode policy engine (tagging rules on SNI/app/destination), never inferred from payload."
        },
        "policy_id": {"type": "string", "description": "Which compliance policy applies (see data/curated/regulations/compliance_zones.json policy_templates)."}
      }
    },
    "Endpoint": {
      "type": "object",
      "required": ["ip"],
      "properties": {
        "ip": {"type": "string"},
        "hostname": {"type": "string"},
        "asn": {"type": "integer"},
        "as_org": {"type": "string"},
        "location": {"$ref": "#/$defs/GeoPoint"},
        "access": {"$ref": "#/$defs/CellularContext"},
        "cloud": {
          "type": "object",
          "properties": {
            "provider": {"enum": ["aws", "gcp", "azure", "oracle", "cloudflare", "other"]},
            "region": {"type": "string"},
            "service": {"type": "string"},
            "matched_prefix": {"type": "string"}
          }
        }
      }
    },
    "CellularContext": {
      "type": "object",
      "properties": {
        "access_type": {"enum": ["wired", "wifi", "cellular_4g", "cellular_5g_nsa", "cellular_5g_sa", "satellite_leo", "unknown"]},
        "mcc": {"type": "string", "pattern": "^[0-9]{3}$"},
        "mnc": {"type": "string", "pattern": "^[0-9]{2,3}$"},
        "operator": {"type": "string"},
        "serving_cell": {
          "type": "object",
          "properties": {
            "radio": {"enum": ["GSM", "UMTS", "LTE", "NR"]},
            "tac_or_lac": {"type": "integer"},
            "cell_id": {"type": "integer"},
            "tower_location": {"$ref": "#/$defs/GeoPoint"}
          }
        },
        "cgnat_detected": {"type": "boolean"},
        "packet_gateway": {
          "type": "object",
          "description": "Estimated PGW/UPF egress where MNO traffic enters the public internet.",
          "properties": {
            "egress_ip": {"type": "string"},
            "asn": {"type": "integer"},
            "location": {"$ref": "#/$defs/GeoPoint"},
            "evidence": {"type": "array", "items": {"$ref": "#/$defs/Evidence"}}
          }
        }
      }
    },
    "Hop": {
      "type": "object",
      "required": ["ttl", "responded"],
      "properties": {
        "ttl": {"type": "integer", "minimum": 1},
        "responded": {"type": "boolean"},
        "ip": {"type": "string"},
        "rdns": {"type": "string"},
        "is_private": {"type": "boolean", "description": "RFC1918 / RFC6598 CGNAT / link-local."},
        "rtt_ms": {
          "type": "object",
          "properties": {
            "min": {"type": "number"}, "avg": {"type": "number"}, "max": {"type": "number"},
            "stdev": {"type": "number"}, "samples": {"type": "integer"}
          }
        },
        "loss_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "mpls_labels": {"type": "array", "items": {"type": "integer"}},
        "asn": {"type": "integer"},
        "as_org": {"type": "string"},
        "registry_country": {"type": "string", "description": "Country from RIR delegation / IP-to-ASN. Legal holder, NOT physical location."},
        "location": {"$ref": "#/$defs/GeoPoint"},
        "location_method": {"enum": ["hoiho_rdns", "ripe_ipmap", "ixp_prefix", "facility", "commercial_db", "interpolated", "unknown"]},
        "role": {"enum": ["lan_gateway", "cpe", "access", "mno_core", "mno_gateway", "isp_core", "ixp", "backbone", "landing_station", "cloud_edge", "cloud_internal", "destination", "unknown"]},
        "ixp": {
          "type": "object",
          "properties": {"peeringdb_ix_id": {"type": "integer"}, "name": {"type": "string"}, "city": {"type": "string"}}
        },
        "facility": {
          "type": "object",
          "properties": {"peeringdb_fac_id": {"type": "integer"}, "name": {"type": "string"}}
        },
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/Evidence"}}
      }
    },
    "CableCandidate": {
      "type": "object",
      "required": ["cable_id", "probability"],
      "properties": {
        "cable_id": {"type": "string", "description": "TeleGeography cable id, e.g. 'imewe'."},
        "name": {"type": "string"},
        "probability": {"type": "number", "minimum": 0, "maximum": 1},
        "landing_a": {"type": "string", "description": "TeleGeography landing-point id."},
        "landing_b": {"type": "string"},
        "owner_match": {"type": "boolean", "description": "Hop ASN's organisation appears in cable owners."},
        "rtt_fit": {"type": "number", "description": "0..1 how well cable length explains the RTT delta."},
        "rfs_year": {"type": "integer"},
        "geometry_ref": {"type": "string", "description": "Pointer into cable-geo FeatureCollection for rendering."}
      }
    },
    "Segment": {
      "type": "object",
      "description": "The link between two consecutive located hops; this is what the globe draws as an arc.",
      "required": ["from_ttl", "to_ttl", "medium"],
      "properties": {
        "from_ttl": {"type": "integer"},
        "to_ttl": {"type": "integer"},
        "medium": {"enum": ["lan", "wifi", "cellular_ran", "mno_backhaul", "metro_fiber", "terrestrial_fiber", "subsea_cable", "ixp_fabric", "cloud_backbone", "satellite", "unknown"]},
        "operator_asn": {"type": "integer"},
        "operator_name": {"type": "string"},
        "great_circle_km": {"type": "number"},
        "delta_rtt_ms": {"type": "number", "description": "min RTT(to) - min RTT(from); negative values are clamped to 0 for health scoring."},
        "min_feasible_rtt_ms": {"type": "number", "description": "2 * path_km / 204 (km per ms in fiber, c / 1.468)."},
        "health": {
          "type": "object",
          "properties": {
            "status": {"enum": ["green", "amber", "red", "grey"]},
            "latency_excess_ratio": {"type": "number"},
            "jitter_ms": {"type": "number"},
            "loss_pct": {"type": "number"}
          }
        },
        "subsea": {
          "type": "object",
          "properties": {
            "candidates": {"type": "array", "items": {"$ref": "#/$defs/CableCandidate"}},
            "selected_cable_id": {"type": "string"}
          }
        },
        "terrestrial": {
          "type": "object",
          "properties": {
            "backbone_asn": {"type": "integer"},
            "route_source": {"enum": ["afterfibre", "infrapedia", "national_open_data", "great_circle_estimate"]},
            "via_facilities": {"type": "array", "items": {"type": "integer"}}
          }
        },
        "jurisdictions_crossed": {
          "type": "array",
          "description": "Countries/EEZs the segment geometry passes over or lands in, in order.",
          "items": {
            "type": "object",
            "properties": {
              "iso2": {"type": "string"},
              "kind": {"enum": ["land", "eez", "landing_station", "disputed"]},
              "confidence": {"type": "number"}
            }
          }
        },
        "geometry": {
          "type": "object",
          "description": "GeoJSON LineString for rendering (simplified).",
          "properties": {"type": {"const": "LineString"}, "coordinates": {"type": "array"}}
        }
      }
    },
    "ComplianceEvaluation": {
      "type": "object",
      "properties": {
        "policy_id": {"type": "string"},
        "data_classification": {"type": "string"},
        "verdict": {"enum": ["compliant", "risk", "violation", "unknown"]},
        "alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["severity", "rule", "message"],
            "properties": {
              "alert_id": {"type": "string"},
              "severity": {"enum": ["info", "warning", "critical"]},
              "rule": {"type": "string"},
              "iso2": {"type": "string"},
              "at_ttl": {"type": "integer"},
              "segment_index": {"type": "integer"},
              "message": {"type": "string"},
              "law_refs": {"type": "array", "items": {"type": "string"}, "description": "Law 'short' ids from jurisdictions.json, e.g. 'GDPR', '242-FZ'."},
              "location_confidence": {"type": "number"}
            }
          }
        },
        "jurisdictions_touched": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "iso2": {"type": "string"},
              "zones": {"type": "array", "items": {"type": "string"}},
              "role": {"enum": ["source", "transit", "destination", "cable_landing", "eez_transit", "corporate_control"], "description": "corporate_control = jurisdiction of the operator that owns the hop (e.g. US CLOUD Act reach over AWS), not a physical location."},
              "localization_level": {"type": "string"},
              "law_refs": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "Summary": {
      "type": "object",
      "properties": {
        "end_to_end_rtt_ms": {"type": "number"},
        "hop_count": {"type": "integer"},
        "unresponsive_hops": {"type": "integer"},
        "path_km": {"type": "number"},
        "asn_path": {"type": "array", "items": {"type": "integer"}},
        "countries_path": {"type": "array", "items": {"type": "string"}},
        "media": {"type": "array", "items": {"type": "string"}},
        "overall_health": {"enum": ["green", "amber", "red", "grey"]}
      }
    }
  }
}
