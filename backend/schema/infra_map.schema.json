{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packetpulse.dev/schemas/enrich/infra-map.schema.json",
  "title": "InfraMap (network-to-infrastructure map)",
  "description": "A traceroute enriched with infrastructure telemetry: per-hop geolocation/ASN, per-link medium with ocean-crossing analysis and submarine cable match, the cellular first leg with its MNO gateway hub, and an ordered mapping array pairing every network element with the infrastructure it resolved to.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "map_id", "generated_at", "trace", "device", "hops", "links", "mobile", "mapping", "summary", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "map_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "protocol", "started_at", "finished_at", "reached_destination", "destination_ttl", "hop_count"],
      "properties": {
        "target": {"$ref": "#/$defs/IP"},
        "source": {"type": "string"},
        "protocol": {"enum": ["icmp", "udp"]},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "reached_destination": {"type": "boolean"},
        "destination_ttl": {"type": "integer", "minimum": 0},
        "hop_count": {"type": "integer", "minimum": 0}
      }
    },
    "device": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Device"}]},
    "hops": {"type": "array", "items": {"$ref": "#/$defs/Hop"}},
    "links": {"type": "array", "items": {"$ref": "#/$defs/Link"}},
    "mobile": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/MobileLeg"}]},
    "mapping": {"type": "array", "items": {"$ref": "#/$defs/MappingEntry"}},
    "summary": {"$ref": "#/$defs/Summary"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geoip", "datasets", "enrichment_ms"],
      "properties": {
        "geoip": {"type": "string"},
        "datasets": {"type": ["object", "null"], "additionalProperties": {"type": "string"}},
        "enrichment_ms": {"type": "number", "minimum": 0}
      }
    }
  },
  "$defs": {
    "IP": {"type": "string", "anyOf": [{"format": "ipv4"}, {"format": "ipv6"}]},
    "ISO2": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "LatLon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {"lat": {"type": "number", "minimum": -90, "maximum": 90}, "lon": {"type": "number", "minimum": -180, "maximum": 180}}
    },
    "Medium": {"enum": ["cellular_backhaul", "metro_fiber", "terrestrial_fiber", "subsea_cable"]},

    "Device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "access_type"],
      "properties": {
        "location": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Point"}]},
        "country": {"type": "string"},
        "access_type": {"enum": ["wired", "wifi", "cellular", "unknown"]},
        "mcc": {"type": "string", "pattern": "^[0-9]{3}$"},
        "mnc": {"type": "string", "pattern": "^[0-9]{2,3}$"},
        "serving_cell": {"$ref": "#/$defs/Cell"},
        "serving_cell_error": {"type": "string"}
      }
    },
    "Point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon", "accuracy_km", "source"],
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180},
        "accuracy_km": {"type": "number", "minimum": 0},
        "source": {"type": "string"}
      }
    },
    "Cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mcc", "mnc", "lac", "cell_id", "lat", "lon", "range_m", "samples", "source"],
      "properties": {
        "radio": {"enum": ["GSM", "UMTS", "CDMA", "LTE", "NR"]},
        "mcc": {"type": "integer"}, "mnc": {"type": "integer"}, "lac": {"type": "integer"}, "cell_id": {"type": "integer"},
        "lat": {"type": "number"}, "lon": {"type": "number"},
        "range_m": {"type": "integer", "minimum": 0}, "samples": {"type": "integer", "minimum": 0},
        "source": {"enum": ["opencellid_api", "opencellid_dump"]}
      }
    },

    "GeoRecord": {
      "description": "Merged answer from the GeoIP providers (MaxMind / IPinfo / static). sources says which provider supplied each field group.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ip", "lat", "lon", "has_location"],
      "properties": {
        "ip": {"type": "string"},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180},
        "has_location": {"type": "boolean"},
        "accuracy_km": {"type": "number", "minimum": 0},
        "city": {"type": "string"},
        "region": {"type": "string"},
        "country_iso2": {"$ref": "#/$defs/ISO2"},
        "asn": {"type": "integer", "minimum": 1},
        "as_org": {"type": "string"},
        "isp": {"type": "string"},
        "hostname": {"type": "string"},
        "mobile_mcc": {"type": "string"},
        "mobile_mnc": {"type": "string"},
        "anycast": {"type": "boolean"},
        "sources": {"type": "object", "propertyNames": {"enum": ["location", "asn", "isp", "mobile"]}, "additionalProperties": {"type": "string"}}
      }
    },

    "Hop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ttl", "responded", "address_class", "rtt_ms", "loss_pct", "geo", "location_status", "role"],
      "properties": {
        "ttl": {"type": "integer", "minimum": 1},
        "responded": {"type": "boolean"},
        "ip": {"$ref": "#/$defs/IP"},
        "alternate_ips": {"type": "array", "items": {"$ref": "#/$defs/IP"}},
        "address_class": {"enum": ["public", "private", "cgnat", "reserved", "loopback", "link_local", "unknown"]},
        "hostname": {"type": "string"},
        "rtt_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "avg", "max", "jitter", "samples"],
          "properties": {
            "min": {"type": "number", "minimum": 0}, "avg": {"type": "number", "minimum": 0}, "max": {"type": "number", "minimum": 0},
            "jitter": {"type": "number", "minimum": 0}, "samples": {"type": "array", "items": {"type": "number", "minimum": 0}}
          }
        },
        "loss_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "asn": {"type": "integer", "minimum": 1},
        "as_org": {"type": "string"},
        "isp": {"type": "string"},
        "geo": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/GeoRecord"}]},
        "location_status": {"enum": ["accepted", "rejected_light_speed", "rejected_detour", "no_data", "non_routable", "no_reply"]},
        "location_note": {"type": "string"},
        "role": {"enum": ["destination", "cgnat", "private", "mno_gateway", "cloud_edge", "router", "no_reply", "unknown"]}
      }
    },

    "Endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ttl", "label", "lat", "lon"],
      "properties": {
        "ttl": {"type": "integer", "minimum": 0, "description": "0 = the measuring device"},
        "ip": {"type": "string"},
        "label": {"type": "string"},
        "lat": {"type": "number"}, "lon": {"type": "number"},
        "country_iso2": {"$ref": "#/$defs/ISO2"}
      }
    },

    "Crossing": {
      "description": "Great-circle analysis against Natural Earth land polygons.",
      "type": "object",
      "additionalProperties": false,
      "required": ["distance_km", "crosses_ocean", "water_km", "longest_water_km", "water_fraction", "countries_overflown", "water_runs"],
      "properties": {
        "distance_km": {"type": "number", "minimum": 0},
        "crosses_ocean": {"type": "boolean"},
        "water_km": {"type": "number", "minimum": 0},
        "longest_water_km": {"type": "number", "minimum": 0},
        "water_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "countries_overflown": {"type": "array", "items": {"type": "string"}},
        "water_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from_km", "to_km", "length_km", "entry", "exit", "max_offshore_km", "coastal"],
            "properties": {
              "from_km": {"type": "number"}, "to_km": {"type": "number"}, "length_km": {"type": "number", "minimum": 0},
              "entry": {"$ref": "#/$defs/LatLon"}, "exit": {"$ref": "#/$defs/LatLon"},
              "max_offshore_km": {"type": "number", "minimum": 0},
              "coastal": {"type": "boolean"}
            }
          }
        }
      }
    },

    "Landing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "country", "lat", "lon"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "country": {"type": "string"}, "lat": {"type": "number"}, "lon": {"type": "number"}}
    },

    "CableCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cable_id", "name", "probability", "score", "owner_match", "backhaul_a_km", "backhaul_b_km", "cable_path_km", "expected_rtt_ms", "score_components", "route_landings"],
      "properties": {
        "cable_id": {"type": "string"},
        "name": {"type": "string"},
        "probability": {"type": "number", "minimum": 0, "maximum": 1},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "owner_match": {"type": "boolean"},
        "matched_owners": {"type": "array", "items": {"type": "string"}},
        "rfs_year": {"type": "integer"},
        "landing_a": {"$ref": "#/$defs/Landing"},
        "landing_b": {"$ref": "#/$defs/Landing"},
        "backhaul_a_km": {"type": "number", "minimum": 0},
        "backhaul_b_km": {"type": "number", "minimum": 0},
        "cable_path_km": {"type": "number", "minimum": 0},
        "expected_rtt_ms": {"type": "number", "minimum": 0},
        "corridor_km": {"type": "number", "minimum": 0},
        "score_components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rtt_fit", "endpoints", "owner", "corridor"],
          "properties": {
            "rtt_fit": {"type": "number", "minimum": 0, "maximum": 1}, "endpoints": {"type": "number", "minimum": 0, "maximum": 1},
            "owner": {"type": "number", "minimum": 0, "maximum": 1}, "corridor": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "route": {"type": "array", "items": {"$ref": "#/$defs/LatLon"}, "description": "Along-cable path from the hop A side to the hop B side (selected candidate only)."},
        "route_landings": {"type": "array", "items": {"$ref": "#/$defs/Landing"}, "description": "Landing stations on the matched stretch, in path order."}
      }
    },

    "Link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "from", "to", "distance_km", "delta_rtt_ms", "min_feasible_rtt_ms", "medium", "confidence", "ocean"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "from": {"$ref": "#/$defs/Endpoint"},
        "to": {"$ref": "#/$defs/Endpoint"},
        "via_unlocated_ttls": {"type": "array", "items": {"type": "integer"}},
        "distance_km": {"type": "number", "minimum": 0},
        "delta_rtt_ms": {"type": "number", "minimum": 0},
        "min_feasible_rtt_ms": {"type": "number", "minimum": 0},
        "medium": {"$ref": "#/$defs/Medium"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "operator": {
          "type": "object", "additionalProperties": false, "required": ["asn", "name"],
          "properties": {"asn": {"type": "integer"}, "name": {"type": "string"}}
        },
        "ocean": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Crossing"}]},
        "subsea": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selected", "alternatives"],
          "properties": {
            "selected": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/CableCandidate"}]},
            "alternatives": {"type": "array", "items": {"$ref": "#/$defs/CableCandidate"}},
            "note": {"type": "string"}
          }
        },
        "cellular": {
          "type": "object", "additionalProperties": false, "required": ["operator", "asn"],
          "properties": {"operator": {"type": "string"}, "asn": {"type": "integer"}, "gateway_hub_id": {"type": "string"}}
        }
      },
      "allOf": [
        {"if": {"properties": {"medium": {"const": "subsea_cable"}}}, "then": {"required": ["subsea"]}},
        {"if": {"properties": {"medium": {"const": "cellular_backhaul"}}}, "then": {"required": ["cellular"]}}
      ]
    },

    "Operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asn", "name", "country", "source", "confidence"],
      "properties": {
        "asn": {"type": "integer"}, "name": {"type": "string"}, "brand": {"type": "string"}, "country": {"type": "string"},
        "mcc": {"type": "string"}, "mncs": {"type": "array", "items": {"type": "string"}},
        "source": {"enum": ["seed", "peeringdb_mccmnc", "maxmind_isp", "device"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "Hub": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "city", "country", "lat", "lon", "kind", "facilities", "confidence"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"}, "city": {"type": "string"}, "country": {"type": "string"},
        "lat": {"type": "number"}, "lon": {"type": "number"},
        "kind": {"enum": ["operator_facility", "operator_ixp", "country_interconnection_metro"]},
        "facilities": {"type": "integer", "minimum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "MobileLeg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "evidence", "gateway_ttl", "gateway_ip", "cgnat_ttls", "gateway_hub", "hub_distance_km", "hub_anchor", "hubs_considered", "link_indexes", "confidence"],
      "properties": {
        "operator": {"$ref": "#/$defs/Operator"},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["signal", "value", "confidence"],
            "properties": {
              "signal": {"enum": ["geoip_mobile_codes", "mno_asn_registry", "device_mcc_mnc", "cgnat_before_gateway", "device_access_type"]},
              "value": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        },
        "gateway_ttl": {"type": "integer", "minimum": 1},
        "gateway_ip": {"$ref": "#/$defs/IP"},
        "cgnat_ttls": {"type": "array", "items": {"type": "integer"}},
        "gateway_hub": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Hub"}]},
        "hub_distance_km": {"type": "number", "minimum": 0},
        "hub_anchor": {"enum": ["serving_cell", "device_location", "gateway_geoip", ""]},
        "hubs_considered": {"type": "integer", "minimum": 0},
        "link_indexes": {"type": "array", "items": {"type": "integer"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },

    "MappingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "network", "infrastructure"],
      "properties": {
        "seq": {"type": "integer", "minimum": 1},
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["device", "hop", "link"]},
            "ttl": {"type": "integer"}, "from_ttl": {"type": "integer"}, "to_ttl": {"type": "integer"},
            "ip": {"type": "string"}, "asn": {"type": "integer"}
          }
        },
        "infrastructure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "confidence"],
          "properties": {
            "kind": {"enum": ["device", "cell_tower", "cgnat", "private", "mno_gateway", "router", "cloud_edge", "destination", "no_reply", "unknown",
                              "cellular_backhaul", "metro_fiber", "terrestrial_fiber", "subsea_cable"]},
            "name": {"type": "string"},
            "operator": {"type": "string"},
            "location": {"type": "string"},
            "countries": {"type": "array", "items": {"type": "string"}},
            "cable_id": {"type": "string"},
            "landing_a": {"type": "string"},
            "landing_b": {"type": "string"},
            "hub_id": {"type": "string"},
            "probability": {"type": "number", "minimum": 0, "maximum": 1},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },

    "Summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media", "hop_countries", "countries_traversed", "subsea_cables", "ocean_crossings", "cellular", "located_hops", "rejected_locations", "path_km"],
      "properties": {
        "media": {"type": "array", "items": {"$ref": "#/$defs/Medium"}},
        "hop_countries": {"type": "array", "items": {"type": "string"}},
        "countries_traversed": {"type": "array", "items": {"type": "string"}},
        "subsea_cables": {"type": "array", "items": {"type": "string"}},
        "ocean_crossings": {"type": "integer", "minimum": 0},
        "cellular": {"type": "boolean"},
        "located_hops": {"type": "integer", "minimum": 0},
        "rejected_locations": {"type": "integer", "minimum": 0},
        "path_km": {"type": "number", "minimum": 0}
      }
    }
  }
}
