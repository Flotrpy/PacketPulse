{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packetpulse.dev/schemas/compliance/violation-alert.schema.json",
  "title": "ComplianceViolationAlert",
  "description": "Raised when a payload governed by a compliance profile enters a territory the profile does not permit. One alert per territory entry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "alert_id", "packet_id", "profile_id", "profile_version", "severity", "suspected", "status", "classification",
               "territory", "entered_at", "entered_at_source", "point", "last_compliant_point", "law", "rule", "mitigation", "generated_at"],
  "properties": {
    "type": {"const": "ComplianceViolationAlert"},
    "alert_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "packet_id": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string"},
    "profile_version": {"type": "integer", "minimum": 1},
    "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
    "suspected": {"type": "boolean", "description": "Location confidence was below the profile minimum; severity lowered one level."},
    "status": {"enum": ["open", "acknowledged", "resolved"]},
    "classification": {"type": "string", "description": "The packet data classification that matched the profile, e.g. sensitive_eu_citizen_data."},
    "territory": {
      "description": "The non-permitted territory that was entered.",
      "type": "object",
      "additionalProperties": false,
      "required": ["country_iso2", "regions", "lat", "lon", "located_by"],
      "properties": {
        "country_iso2": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "country_name": {"type": "string"},
        "subdivision": {"type": "string", "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"},
        "subdivision_name": {"type": "string"},
        "regions": {"type": "array", "items": {"type": "string"}},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180},
        "located_by": {"enum": ["polygon", "nearest_coast", "hint"]}
      }
    },
    "entered_at": {"type": "string", "format": "date-time", "description": "When the packet reached the first point in the territory."},
    "entered_at_source": {"enum": ["probe_sent_plus_half_rtt", "interpolated_along_cable", "trace_start", "route_point", "packet_timestamp"]},
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "kind", "location_confidence"],
      "properties": {
        "seq": {"type": "integer", "minimum": 0},
        "ttl": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["source", "hop", "subsea_landing", "destination"]},
        "ip": {"type": "string"},
        "asn": {"type": "integer", "minimum": 1},
        "operator": {"type": "string"},
        "label": {"type": "string"},
        "location_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "location_source": {"type": "string"}
      }
    },
    "last_compliant_point": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["seq", "country_iso2", "lat", "lon", "at"],
          "properties": {
            "seq": {"type": "integer"}, "country_iso2": {"type": "string"}, "label": {"type": "string"},
            "lat": {"type": "number"}, "lon": {"type": "number"}, "at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "law": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "title", "citation"],
      "properties": {
        "code": {"type": "string"}, "title": {"type": "string"}, "citation": {"type": "string"},
        "articles": {"type": "array", "items": {"type": "string"}}, "url": {"type": "string", "format": "uri"}
      }
    },
    "rule": {"type": "string"},
    "exception": {"type": "string", "description": "Set when an exception downgraded the alert (e.g. DPF verification needed)."},
    "mitigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "recommendation"],
      "properties": {
        "action": {"enum": ["reroute", "block", "review", "contract"]},
        "recommendation": {"type": "string", "minLength": 10},
        "proxy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "provider", "cloud_region", "city", "lat", "lon"],
          "properties": {
            "id": {"type": "string"}, "name": {"type": "string"}, "provider": {"type": "string"}, "cloud_region": {"type": "string"},
            "city": {"type": "string"}, "lat": {"type": "number"}, "lon": {"type": "number"}, "notes": {"type": "string"}
          }
        },
        "proxy_distance_km": {"type": "number", "minimum": 0},
        "alternatives": {"type": "array", "items": {"type": "string"}}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
